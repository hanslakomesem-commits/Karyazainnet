# Secrets only on the BACKEND service, never commit real values.
GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
FRONTEND_ORIGINS=https://USERNAME.github.io,https://www.karyazainnet.net
ADMIN_API_TOKEN=CHOOSE_A_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
# Optional durable object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
# Frontend build variables (GitHub Actions VARIABLES, not SECRETS)
VITE_API_BASE_URL=https://YOUR_BACKEND.onrender.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
VITE_BASE_PATH=/
